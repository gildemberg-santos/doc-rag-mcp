# Embeddings e geração 100% locais via Ollama (sem API externa, sem key).
EMBED_PROVIDER=ollama

# Ollama (local ou container `ollama` no compose)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=nomic-embed-text
# OLLAMA_EMBED_DIMS=768  # 1024 p/ mxbai-embed-large

# Geração de documentação por arquivo (cmd/docgen) — modelo independente
# do de embedding (vazio = default local validado).
# DOCGEN_MODEL=qwen2.5-coder:7b
# Etapa filedocs no indexer --watch (Fase 4): DOCGEN_ENABLED=true liga o
# --generate-docs sem a flag; DOCGEN_INTERVAL limita a frequência (default
# 24h; completions são caras); DOCGEN_PROJECTS restringe a projetos (csv,
# vazio = todos).
# DOCGEN_ENABLED=true
# DOCGEN_INTERVAL=24h
# DOCGEN_PROJECTS=neurolead,neurolead-client

# Qdrant (coleção única `docs`, 100% local).
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=docs
# QDRANT_API_KEY: exigida pelo Qdrant (server + todos os clients).
# Rotação: openssl rand -hex 32 + restart de toda a stack junta.
# QDRANT_API_KEY=

# Local (sem docker): aponte para a pasta com seus projetos
PROJECTS_ROOT=/home/gildembergsantos/Documentos
HTTP_PORT=8080
MCP_NAME=doc-rag-mcp
MCP_VERSION=1.0.0

# --- Observabilidade (/status + /dashboard) ---
# Nível 2 — heartbeat do indexer --watch (arquivo compartilhado).
# No compose já vai pra /state (volume status_state); local: aponte pra um
# caminho gravável qualquer. Vazio = seção omitida no /status.
INDEXER_STATUS_FILE=/state/indexer-status.json
# Nível 3 — série temporal do /status (JSONL, 1 linha por /status real).
# Vazio = só buffer em memória (perde no restart).
STATUS_HISTORY_FILE=/state/history.jsonl
# Nível 3 — socket Docker (OPT-IN, privilegiado: mesmo ":ro", o container
# passa a falar com o daemon; o servidor só faz GET de leitura).
# Pra ativar no compose, descomente o volume do socket. Vazio = omitido.
DOCKER_SOCKET=/var/run/docker.sock
# Filtra a seção de containers por projeto compose (vazio = lista tudo).
COMPOSE_PROJECT_NAME=

# Token de acesso ao HTTP (mcp-server): exige
# `Authorization: Bearer <token>` em /mcp, /search, /status e /dashboard.
# Vazio = sem auth (ok em localhost/rede confiável). Gere com:
# openssl rand -hex 32
# MCP_AUTH_TOKEN=
