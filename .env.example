# Provider de embeddings: openai (API paga, melhor qualidade) ou ollama (local grátis)
EMBED_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_EMBED_MODEL=text-embedding-3-small
# OPENAI_EMBED_DIMS=1536  # opcional; 3072 para text-embedding-3-large

# Ollama local (só usado com EMBED_PROVIDER=ollama ou --provider ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=nomic-embed-text
# OLLAMA_EMBED_DIMS=768  # 1024 p/ mxbai-embed-large

# QDRANT_COLLECTION é a base: openai usa "docs" (índice atual intacto),
# ollama usa "docs-ollama" (coleção separada, dims diferentes).
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=docs

# Local (sem docker): aponte para a pasta com seus projetos
PROJECTS_ROOT=/home/gildembergsantos/Documentos
HTTP_PORT=8080
MCP_NAME=doc-rag-mcp
MCP_VERSION=1.0.0
